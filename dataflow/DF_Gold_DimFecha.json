{
	"name": "DF_Gold_DimFecha",
	"properties": {
		"folder": {
			"name": "DF-Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Gold_DimFecha",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    CAST(CONVERT(VARCHAR(8), fecha, 112) AS INT) AS fecha_key,\\n    fecha AS fecha_completa,\\n    CAST(YEAR(fecha) AS INT) AS anio,\\n    CAST(DATEPART(QUARTER, fecha) AS INT) AS trimestre,\\n    CONCAT(\\'T\\', DATEPART(QUARTER, fecha)) AS trimestre_nombre,\\n    CAST(MONTH(fecha) AS INT) AS mes,\\n    DATENAME(MONTH, fecha) AS mes_nombre,\\n    CAST(LEFT(DATENAME(MONTH, fecha), 3) AS VARCHAR(3)) AS mes_corto,\\n    CAST(DATEPART(WEEK, fecha) AS INT) AS semana_anio,\\n    CAST(DAY(fecha) AS INT) AS dia_mes,\\n    CAST(DATEPART(WEEKDAY, fecha) AS INT) AS dia_semana,\\n    DATENAME(WEEKDAY, fecha) AS dia_nombre,\\n    CASE WHEN DATEPART(WEEKDAY, fecha) IN (1, 7) THEN CAST(1 AS BIT) ELSE CAST(0 AS BIT) END AS es_fin_de_semana\\nFROM (\\n    SELECT admission_date AS fecha FROM silver.admissions WHERE admission_date IS NOT NULL\\n    UNION\\n    SELECT discharge_date AS fecha FROM silver.admissions WHERE discharge_date IS NOT NULL\\n    UNION\\n    SELECT payment_date AS fecha FROM silver.billing WHERE payment_date IS NOT NULL\\n) AS f\\nWHERE CAST(CONVERT(VARCHAR(8), fecha, 112) AS INT) <> 19000101',",
				"     format: 'query') ~> source1",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          fecha_key,",
				"          fecha_completa,",
				"          anio,",
				"          trimestre,",
				"          trimestre_nombre,",
				"          mes,",
				"          mes_nombre,",
				"          mes_corto,",
				"          semana_anio,",
				"          dia_mes,",
				"          dia_semana,",
				"          dia_nombre,",
				"          es_fin_de_semana",
				"     )) ~> sink1"
			]
		}
	}
}