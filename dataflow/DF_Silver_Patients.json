{
	"name": "DF_Silver_Patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Patients",
						"type": "DatasetReference"
					},
					"name": "OrigenPatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "LimpiezaTexto"
				},
				{
					"name": "ConversionTipos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OrigenPatients",
				"OrigenPatients derive(full_name = coalesce(initCap(trim(full_name)), 'SIN NOMBRE'),",
				"          gender = case(lower(trim(gender)) == 'm' || lower(trim(gender)) == 'male', 'M', lower(trim(gender)) == 'f' || lower(trim(gender)) == 'female', 'F', upper(trim(gender))),",
				"          phone = trim(phone),",
				"          email = lower(trim(email)),",
				"          address = trim(address),",
				"          insurance_provider = upper(trim(insurance_provider))) ~> LimpiezaTexto",
				"LimpiezaTexto derive(patient_id = toInteger(trim(patient_id)),",
				"          date_of_birth = coalesce(   toDate(trim(date_of_birth), 'MMMM dd, yyyy', 'en-US'),   toDate(trim(date_of_birth), 'MMM dd, yyyy', 'en-US'),   toDate(trim(date_of_birth), 'yyyy-MM-dd'),   toDate(trim(date_of_birth), 'MM-dd-yy'),   toDate(trim(date_of_birth), 'MM/dd/yyyy'),   toDate(trim(date_of_birth), 'dd/MM/yyyy') )) ~> ConversionTipos",
				"ConversionTipos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}