		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_DimServicioCargo')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "DF-Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Billing",
								"type": "DatasetReference"
							},
							"name": "OrigenDimServicioCargo"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_DimServicioCargo",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT DISTINCT\\n    ISNULL(charge_type, \\'OTROS\\') AS tipo_cargo,\\n    ISNULL(payment_status, \\'PENDIENTE\\') AS estado_pago\\nFROM silver.billing',",
						"     format: 'query') ~> OrigenDimServicioCargo",
						"OrigenDimServicioCargo sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          servicio_cargo_key as integer,",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          tipo_cargo,",
						"          estado_pago",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_FactAdmisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "DF-Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimPaciente",
								"type": "DatasetReference"
							},
							"name": "DimPaciente"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimDepartamento",
								"type": "DatasetReference"
							},
							"name": "DimDepartamento"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimDiagnostico",
								"type": "DatasetReference"
							},
							"name": "DimDiagnostico"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimFecha",
								"type": "DatasetReference"
							},
							"name": "DimFechaIngreso"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimFecha",
								"type": "DatasetReference"
							},
							"name": "DimFechaAlta"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_FactAdmisiones",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "LkpPaciente"
						},
						{
							"name": "LkpDepartamento"
						},
						{
							"name": "LkpDiagnostico"
						},
						{
							"name": "LkpFechaIngreso"
						},
						{
							"name": "LkpFechaAlta"
						},
						{
							"name": "ControlNulosKeys"
						},
						{
							"name": "SelectAdmisiones"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          patient_id as integer,",
						"          department as string,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer,",
						"          icd_code as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    a.admission_id AS admission_id_bk,\\n    a.patient_id,\\n    ISNULL(a.department, \\'GENERAL\\') AS department,\\n    a.admission_date,\\n    a.discharge_date,\\n    ISNULL(a.attending_doctor_id, 0) AS medico_id,\\n    CASE WHEN a.discharge_date IS NOT NULL THEN DATEDIFF(DAY, a.admission_date, a.discharge_date) ELSE NULL END AS dias_estancia,\\n    1 AS conteo_admisiones,\\n    d.icd_code\\nFROM silver.admissions a\\nLEFT JOIN (\\n    SELECT admission_id, MIN(icd_code) AS icd_code\\n    FROM silver.diagnoses\\n    GROUP BY admission_id\\n) d ON a.admission_id = d.admission_id',",
						"     format: 'query') ~> source1",
						"source(output(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimPaciente",
						"source(output(",
						"          departamento_key as integer,",
						"          nombre_departamento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimDepartamento",
						"source(output(",
						"          diagnostico_key as integer,",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimDiagnostico",
						"source(output(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimFechaIngreso",
						"source(output(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimFechaAlta",
						"source1, DimPaciente lookup(patient_id == patient_id_bk,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpPaciente",
						"LkpPaciente, DimDepartamento lookup(department == nombre_departamento,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpDepartamento",
						"LkpDepartamento, DimDiagnostico lookup(icd_code == codigo_icd,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpDiagnostico",
						"LkpDiagnostico, DimFechaIngreso lookup(admission_date == fecha_completa,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpFechaIngreso",
						"LkpFechaIngreso, DimFechaAlta lookup(discharge_date == DimFechaAlta@fecha_completa,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpFechaAlta",
						"LkpFechaAlta derive(paciente_key = coalesce(paciente_key, 0),",
						"          departamento_key = coalesce(departamento_key, 0),",
						"          diagnostico_key = coalesce(diagnostico_key, 0),",
						"          fecha_ingreso_key = coalesce(DimFechaIngreso@fecha_key, 19000101),",
						"          fecha_alta_key = DimFechaAlta@fecha_key) ~> ControlNulosKeys",
						"ControlNulosKeys select(mapColumn(",
						"          admission_id_bk,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key,",
						"          fecha_alta_key",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectAdmisiones",
						"SelectAdmisiones sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key,",
						"          fecha_alta_key,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_FactFacturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "DF-Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Billing",
								"type": "DatasetReference"
							},
							"name": "OrigenFacturacion"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimPaciente",
								"type": "DatasetReference"
							},
							"name": "DimPaciente"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimDepartamento",
								"type": "DatasetReference"
							},
							"name": "DimDepartamento"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimServicioCargo",
								"type": "DatasetReference"
							},
							"name": "DimServicioCargo"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_DimFecha",
								"type": "DatasetReference"
							},
							"name": "DimFechaPago"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_FactFacturacion",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "LkpPaciente"
						},
						{
							"name": "LkpDepartamento"
						},
						{
							"name": "LkpServicio"
						},
						{
							"name": "LkpFechaPago"
						},
						{
							"name": "ControlNulosFact"
						},
						{
							"name": "SelectFacturacion"
						}
					],
					"scriptLines": [
						"source(output(",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          patient_id as integer,",
						"          department as string,",
						"          charge_type as string,",
						"          payment_status as string,",
						"          payment_date as date,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n    a.patient_id,\\n    ISNULL(a.department, \\'GENERAL\\') AS department,\\n    ISNULL(b.charge_type, \\'OTROS\\') AS charge_type,\\n    ISNULL(b.payment_status, \\'PENDIENTE\\') AS payment_status,\\n    b.payment_date,\\n    ISNULL(b.amount, 0.00) AS monto_facturado,\\n    1 AS conteo_transacciones\\nFROM silver.billing b\\nLEFT JOIN silver.admissions a ON b.admission_id = a.admission_id',",
						"     format: 'query') ~> OrigenFacturacion",
						"source(output(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimPaciente",
						"source(output(",
						"          departamento_key as integer,",
						"          nombre_departamento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimDepartamento",
						"source(output(",
						"          servicio_cargo_key as integer,",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimServicioCargo",
						"source(output(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DimFechaPago",
						"OrigenFacturacion, DimPaciente lookup(patient_id == patient_id_bk,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpPaciente",
						"LkpPaciente, DimDepartamento lookup(department == nombre_departamento,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpDepartamento",
						"LkpDepartamento, DimServicioCargo lookup(charge_type == tipo_cargo",
						"     && payment_status == estado_pago,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpServicio",
						"LkpServicio, DimFechaPago lookup(payment_date == fecha_completa,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpFechaPago",
						"LkpFechaPago derive(paciente_key = coalesce(paciente_key, 0),",
						"          departamento_key = coalesce(departamento_key, 0),",
						"          servicio_cargo_key = coalesce(servicio_cargo_key, 0),",
						"          fecha_pago_key = toInteger(fecha_key)) ~> ControlNulosFact",
						"ControlNulosFact select(mapColumn(",
						"          billing_id_bk,",
						"          admission_id_bk,",
						"          monto_facturado,",
						"          conteo_transacciones,",
						"          paciente_key,",
						"          departamento_key,",
						"          servicio_cargo_key,",
						"          fecha_pago_key",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectFacturacion",
						"SelectFacturacion sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          facturacion_key as long,",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          billing_id_bk,",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          servicio_cargo_key,",
						"          fecha_pago_key,",
						"          monto_facturado,",
						"          conteo_transacciones",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Admissions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Admissions",
								"type": "DatasetReference"
							},
							"name": "OrigenAdmissions"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "LimpiezaTexto"
						},
						{
							"name": "ConversionTipos"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenAdmissions",
						"OrigenAdmissions derive(department = coalesce(upper(trim(department)), 'GENERAL')) ~> LimpiezaTexto",
						"LimpiezaTexto derive(admission_id = toInteger(trim(admission_id)),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          attending_doctor_id = coalesce(toInteger(trim(attending_doctor_id)), 0),",
						"          admission_date = coalesce(toDate(trim(admission_date), 'MMMM dd, yyyy', 'en-US'), toDate(trim(admission_date), 'yyyy-MM-dd'), toDate(trim(admission_date), 'MM-dd-yy'), toDate(trim(admission_date), 'MM/dd/yyyy'), toDate(trim(admission_date), 'dd/MM/yyyy'), toDate('1900-01-01')),",
						"          discharge_date = coalesce(toDate(trim(discharge_date), 'MMMM dd, yyyy', 'en-US'), toDate(trim(discharge_date), 'yyyy-MM-dd'), toDate(trim(discharge_date), 'MM-dd-yy'), toDate(trim(discharge_date), 'MM/dd/yyyy'), toDate(trim(discharge_date), 'dd/MM/yyyy'))) ~> ConversionTipos",
						"ConversionTipos sink(allowSchemaDrift: true,",
