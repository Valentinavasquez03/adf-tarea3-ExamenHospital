	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_DimDepartamento')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "DF-Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "OrigenDimDepartamento"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_DimDepartamento",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          nombre_departamento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT DISTINCT\\n    ISNULL(department, \\'GENERAL\\') AS nombre_departamento\\nFROM silver.admissions',",
						"     format: 'query') ~> OrigenDimDepartamento",
						"OrigenDimDepartamento sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          departamento_key as integer,",
						"          nombre_departamento as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          nombre_departamento",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_DimDiagnostico')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "DF-Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "OrigenDimDiagnostico"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_DimDiagnostico",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    icd_code AS codigo_icd,\\n    MAX(diagnosis_description) AS descripcion_patologia,\\n    ISNULL(MAX(severity), \\'NO ESPECIFICADA\\') AS nivel_severidad\\nFROM silver.diagnoses\\nWHERE icd_code IS NOT NULL\\nGROUP BY icd_code',",
						"     format: 'query') ~> OrigenDimDiagnostico",
						"OrigenDimDiagnostico sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          diagnostico_key as integer,",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          codigo_icd,",
						"          descripcion_patologia,",
						"          nivel_severidad",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
