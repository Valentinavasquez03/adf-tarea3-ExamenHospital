						"     query: 'SELECT DISTINCT\\n    patient_id AS patient_id_bk,\\n    ISNULL(full_name, \\'SIN NOMBRE\\') AS nombre_completo,\\n    ISNULL(gender, \\'NO ESPECIFICADO\\') AS genero,\\n    date_of_birth AS fecha_nacimiento,\\n    CASE\\n        WHEN date_of_birth IS NULL THEN \\'DESCONOCIDO\\'\\n        WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) < 18 THEN \\'MENOR (<18)\\'\\n        WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) BETWEEN 18 AND 35 THEN \\'JOVEN (18-35)\\'\\n        WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) BETWEEN 36 AND 60 THEN \\'ADULTO (36-60)\\'\\n        ELSE \\'ADULTO MAYOR (>60)\\'\\n    END AS rango_etario,\\n    email AS correo_electronico,\\n    address AS direccion,\\n    ISNULL(insurance_provider, \\'SIN SEGURO\\') AS proveedor_seguro\\nFROM silver.patients',",
