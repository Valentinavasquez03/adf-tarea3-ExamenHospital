						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          fecha_key,",
						"          fecha_completa,",
						"          anio,",
						"          trimestre,",
						"          trimestre_nombre,",
						"          mes,",
						"          mes_nombre,",
						"          mes_corto,",
						"          semana_anio,",
						"          dia_mes,",
						"          dia_semana,",
						"          dia_nombre,",
						"          es_fin_de_semana",
						"     )) ~> sink1"
					]
				}
